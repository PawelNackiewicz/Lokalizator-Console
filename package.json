{
  "name": "lokalizator-console",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo: konsola do przeglądania szkół (lista + mapa) z logowaniem.",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "db:generate": "pnpm --filter @lokalizator/api run db:generate",
    "db:migrate": "pnpm --filter @lokalizator/api run db:migrate",
    "db:seed": "pnpm --filter @lokalizator/api run db:seed",
    "db:studio": "pnpm --filter @lokalizator/api run db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
