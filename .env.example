# ---------------------------------------------------------------------------
# Jeden plik .env dla całego monorepo.
#  - docker compose czyta go automatycznie (leży obok docker-compose.yml)
#  - apps/api ładuje go przez ConfigModule (envFilePath -> root repo)
#  - apps/web czyta go przez Vite (envDir -> root repo), ale WIDZI tylko VITE_*
#
# Skopiuj do `.env` i uzupełnij sekrety:  cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Postgres (docker-compose) ---------------------------------------------
POSTGRES_USER=lokalizator
POSTGRES_PASSWORD=lokalizator
POSTGRES_DB=lokalizator
POSTGRES_PORT=5432

# --- Backend (apps/api) -----------------------------------------------------
API_PORT=3000

# Musi zgadzać się z wartościami POSTGRES_* powyżej.
DATABASE_URL=postgres://lokalizator:lokalizator@localhost:5432/lokalizator

# Sekret do podpisywania JWT. W development możesz zostawić poniższy,
# w produkcji WYGENERUJ własny:  openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-min-32-characters-long
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=lokalizator_token

# Origin frontendu — używany przez CORS backendu (musi być dokładny, bo
# przesyłamy credentials/cookies).
WEB_ORIGIN=http://localhost:5173

# --- Seed (pnpm db:seed) ----------------------------------------------------
# Dane pierwszego użytkownika. Hasło jest hashowane przed zapisem do bazy.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin

# --- Frontend (apps/web) ----------------------------------------------------
# Tylko zmienne z prefiksem VITE_ trafiają do bundla przeglądarki.
WEB_PORT=5173
VITE_API_URL=http://localhost:3000
