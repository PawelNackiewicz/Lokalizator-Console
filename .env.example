# ---------------------------------------------------------------------------
# One .env file for the whole monorepo.
#  - docker compose reads it automatically (it sits next to docker-compose.yml)
#  - apps/api loads it through ConfigModule (envFilePath -> repo root)
#  - apps/web reads it through Vite (envDir -> repo root), but SEES only VITE_*
#
# Copy to `.env` and fill in the secrets:  cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Postgres (docker-compose) ---------------------------------------------
POSTGRES_USER=lokalizator
POSTGRES_PASSWORD=lokalizator
POSTGRES_DB=lokalizator
POSTGRES_PORT=5432

# --- Backend (apps/api) -----------------------------------------------------
API_PORT=3000

# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://lokalizator:lokalizator@localhost:5432/lokalizator

# Secret used to sign JWTs. The value below is fine in development;
# in production GENERATE your own:  openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-min-32-characters-long
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=lokalizator_token

# Web app origin — used by the backend's CORS (must be exact, because we send
# credentials/cookies).
WEB_ORIGIN=http://localhost:5173

# --- Seed (pnpm db:seed) ----------------------------------------------------
# Credentials of the first user. The password is hashed before it hits the database.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin

# --- Frontend (apps/web) ----------------------------------------------------
# Only VITE_-prefixed variables reach the browser bundle.
WEB_PORT=5173
VITE_API_URL=http://localhost:3000
